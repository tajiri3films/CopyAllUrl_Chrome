{
	"manifest_version": 3,
	"name": "Copy All Urls",
	"version": "3.0",
	"description": "Copy tabs URL to clipboard (formats : text, HTML, JSON or custom). Paste to open multiple URL at one go.",
	"icons": {
		"128": "img/umbrella_128.png",
		"64": "img/umbrella_64.png",
		"19": "img/umbrella_19.png"
	},
	"action": {
		"default_icon": "img/umbrella_19.png",
		"default_title": "Copy URLs to clipboard",
		"default_popup": "popup.html"
	},
	"background": {
		"service_worker": "background.js"
	},
	"commands": {
		"copy": {
			"suggested_key": {
				"default": "Alt+C"
			},
			"description": "Copy"
		},
		"paste": {
			"suggested_key": {
				"default": "Alt+V"
			},
			"description": "Paste"
		}
	},
	"options_page": "options.html",
	"permissions": ["tabs", "storage", "clipboardRead", "clipboardWrite", "notifications", "offscreen"]
}
